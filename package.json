{
	"name": "thepetgallery",
	"version": "1.0.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"android": "expo run:android",
		"ios": "expo run:ios",
		"start": "watchman watch-del-all && npx expo start",
		"build:android": "node scripts/build-android-local.js",
		"build:ios": "node scripts/build-ios-local.js",
		"lint": "eslint .",
		"test": "jest",
		"build:ios:eas": "eas build --platform ios --profile production --local",
		"build:android:eas": "eas build --platform android --profile production --local",
		"release:ios": "bundle exec fastlane ios release",
		"release:android": "bundle exec fastlane android release",
		"release:all": "bundle exec fastlane release_all",
		"publish:ota": "node scripts/publish-ota.js",
		"store:patch-notes": "bundle exec fastlane update_patch_notes",
		"store:patch-notes:upload:ios": "bundle exec fastlane ios upload_patch_notes",
		"store:patch-notes:upload:android": "bundle exec fastlane android upload_patch_notes",
		"store:listing": "node fastlane/store_listing/generate.js",
		"store:listing:upload:ios": "bundle exec fastlane ios upload_listing",
		"store:listing:upload:android": "bundle exec fastlane android upload_listing",
		"store:listing:download:ios": "bundle exec fastlane ios download_listing",
		"store:listing:download:android": "bundle exec fastlane android download_listing",
		"prebuild:dev": "APP_VARIANT=development DISABLE_CODE_SIGNING=1 npx expo prebuild --clean",
		"ios:dev": "DISABLE_CODE_SIGNING=1 expo run:ios",
		"android:dev": "DISABLE_CODE_SIGNING=1 node scripts/build-android-dev.js",
		"start:dev": "DISABLE_CODE_SIGNING=1 expo start --dev-client"
	},
	"dependencies": {
		"@invertase/react-native-apple-authentication": "^2.5.1",
		"@react-native-community/netinfo": "^12.0.1",
		"@react-native-firebase/analytics": "^27.1.1",
		"@react-native-firebase/app": "^27.1.1",
		"@react-native-firebase/auth": "^27.1.1",
		"@react-native-firebase/firestore": "^27.1.1",
		"@react-native-firebase/messaging": "^27.1.1",
		"@react-native-google-signin/google-signin": "^17.0.0",
		"@react-native-vector-icons/ionicons": "^13.1.2",
		"@react-native-vector-icons/material-design-icons": "latest",
		"@sentry/react-native": "~8.28.0",
		"axios": "^1.21.1",
		"css-to-react-native": "^3.2.0",
		"expo": "^58.0.26",
		"expo-apple-authentication": "~58.0.3",
		"expo-asset": "~58.0.21",
		"expo-build-properties": "~58.0.12",
		"expo-clipboard": "~58.0.4",
		"expo-constants": "~58.0.16",
		"expo-dev-client": "58.0.21",
		"expo-file-system": "~58.0.14",
		"expo-font": "~58.0.12",
		"expo-image": "~58.0.18",
		"expo-linking": "~58.0.17",
		"expo-media-library": "~58.0.14",
		"expo-notifications": "~58.1.9",
		"expo-observe": "~58.0.19",
		"expo-router": "~58.0.32",
		"expo-secure-store": "~58.0.3",
		"expo-status-bar": "~58.0.5",
		"expo-symbols": "~58.0.5",
		"expo-tracking-transparency": "~58.1.0",
		"expo-updates": "~58.0.22",
		"i18next": "^26.0.4",
		"lottie-react-native": "^7.5.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-i18next": "^16.1.6",
		"react-native": "0.88.1",
		"react-native-context-menu-view": "^1.21.0",
		"react-native-device-info": "^15.0.2",
		"react-native-flash-message": "^0.4.2",
		"react-native-get-random-values": "^1.11.0",
		"react-native-google-mobile-ads": "~17.4.0",
		"react-native-paper": "^5.15.0",
		"react-native-permissions": "^5.5.1",
		"react-native-radio-buttons-group": "^3.1.0",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-share": "^12.2.6",
		"react-native-ui-datepicker": "^3.1.2",
		"react-native-uuid": "^2.0.4",
		"styled-components": "^6.5.2",
		"uuid": "^14.0.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@types/react": "~19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-native-get-random-values": "^1",
		"eas-build-cache-provider": "^21.0.0",
		"eslint": "^9.39.4",
		"eslint-plugin-prettier": "^5.5.5",
		"prettier": "~3.8.1",
		"tsx": "^4.20.5",
		"typescript": "~6.0.3"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
